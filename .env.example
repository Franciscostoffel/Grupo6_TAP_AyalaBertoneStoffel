# Copiá este archivo con el nombre .env (en la misma carpeta) y pegá tu clave
# de Gemini después del "=". La clave se consigue gratis en Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# El archivo .env no se sube a GitHub (está en .gitignore): cada uno usa su clave.
# Funciona igual con Docker (docker compose up) y sin Docker (uvicorn).

GEMINI_API_KEY=

# Modelo de Gemini. No hace falta cambiarlo.
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL: con Compose, dejar vacío para usar el servicio db.
# Sin Docker: postgresql://inversion:inversion@localhost:5432/investments
# En Render configurar la URL de Supabase en Environment; nunca subir la URL real.
DATABASE_URL=

# Render: production y únicamente el origen HTTPS público (sin rutas).
APP_ENV=development
AUTH_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
