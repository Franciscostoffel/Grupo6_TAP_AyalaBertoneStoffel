# Copiá este archivo con el nombre .env (en la misma carpeta) y pegá tu clave
# de Gemini después del "=". La clave se consigue gratis en Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# El archivo .env no se sube a GitHub (está en .gitignore): cada uno usa su clave.
# Funciona igual con Docker (docker compose up) y sin Docker (uvicorn).

GEMINI_API_KEY=

# Modelo de Gemini. No hace falta cambiarlo.
GEMINI_MODEL=gemini-3.5-flash-lite
